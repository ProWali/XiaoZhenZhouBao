; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="小镇周报"
config/description="一款系统驱动的叙事模拟游戏：你是一座程序生成小镇上唯一一份报纸的主编。"
boot_splash/bg_color=Color(0.109804, 0.105882, 0.12549, 1)
boot_splash/show_image=false
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.png"
config/windows_native_icon="res://assets/icon.ico"
config/version="0.4.0-m4"

[autoload]

Game="*res://scripts/ui/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[gui]

theme/default_font_antialiasing=0

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
